FROM node:18-alpine AS build

WORKDIR /app

COPY frontend/package.json .
RUN npm install

COPY frontend/ .
RUN npm run build

# Serve static files with a lightweight server
FROM node:18-alpine

WORKDIR /app
RUN npm install -g serve

COPY --from=build /app/build ./build

ENV PORT=3000

CMD serve -s build -l $PORT
